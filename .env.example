# Variabel environment untuk Premium Wedding Invitation Studio.
#
# PENTING: server tidak memakai pustaka dotenv — file .env TIDAK dibaca otomatis.
# Set variabel lewat environment shell / PM2 / systemd, contoh:
#   PORT=3000 node server.js
#
# Satu-satunya variabel yang dipakai server saat ini:

# Port HTTP server (default: 3000)
PORT=3000

# Database selalu di ./data/wedding.db (db.js, path tetap — tidak bisa diubah via env).
